{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"lib": ["ESNext", "DOM"],
		"types": ["vite/client", "@cloudflare/workers-types/2023-07-01", "@types/node", "@types/bun"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
